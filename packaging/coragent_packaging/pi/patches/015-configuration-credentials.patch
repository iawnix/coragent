diff --git a/packages/coding-agent/src/core/auth-storage.ts b/packages/coding-agent/src/core/auth-storage.ts
--- a/packages/coding-agent/src/core/auth-storage.ts
+++ b/packages/coding-agent/src/core/auth-storage.ts
@@ -345,6 +345,32 @@
 	}
 
 	static create(authPath: string = join(getAgentDir(), "auth.json")): AuthStorage {
+		const credentialsPath = process.env.CORAGENT_CREDENTIALS_FILE;
+		if (credentialsPath && authPath === join(getAgentDir(), "auth.json")) {
+			const file = new FileAuthStorageBackend(credentialsPath);
+			const unpack = (current: string | undefined) => {
+				const document = JSON.parse(current ?? '{"models":{},"secrets":{}}');
+				if (!document || typeof document !== "object" || Array.isArray(document)
+					|| !document.models || typeof document.models !== "object" || Array.isArray(document.models)) {
+					throw new Error("Invalid CoRAgent credentials document");
+				}
+				return document;
+			};
+			return AuthStorage.fromStorage({
+				withLock: (fn) => file.withLock((current) => {
+					const document = unpack(current);
+					const result = fn(JSON.stringify(document.models));
+					return { result: result.result, next: result.next === undefined ? undefined
+						: JSON.stringify({ ...document, models: JSON.parse(result.next) }, null, 2) + "\n" };
+				}),
+				withLockAsync: (fn, options) => file.withLockAsync(async (current) => {
+					const document = unpack(current);
+					const result = await fn(JSON.stringify(document.models));
+					return { result: result.result, next: result.next === undefined ? undefined
+						: JSON.stringify({ ...document, models: JSON.parse(result.next) }, null, 2) + "\n" };
+				}, options),
+			});
+		}
 		const normalizedAuthPath = normalizePath(authPath);
 		return new AuthStorage(new FileAuthStorageBackend(normalizedAuthPath), normalizedAuthPath);
 	}
