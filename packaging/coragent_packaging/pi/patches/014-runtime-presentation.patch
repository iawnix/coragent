new file mode 100644
index 0000000..b08cedd
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/components/runtime-task-message.ts
@@ -0,0 +1,27 @@
+import { Container, Text } from "@earendil-works/pi-tui";
+import { theme } from "../theme/theme.ts";
+
+const START = '<runtime_task_continuation origin="runtime">';
+const END = "</runtime_task_continuation>";
+const LEGACY_START = "Continue the existing authorized user task using the runtime task snapshot.";
+const LEGACY_COMPLETION = "Recover only the final response for the existing completion proposal.";
+
+/** Recognize current and pre-marker task-controller messages in durable sessions. */
+export function isRuntimeTaskContinuation(text: string): boolean {
+	const value = text.trim();
+	return (value.startsWith(START) && value.endsWith(END))
+		|| value.startsWith(LEGACY_START)
+		|| value.startsWith(LEGACY_COMPLETION);
+}
+
+/** Compact runtime status; the full control prompt remains model-visible only. */
+export class RuntimeTaskMessageComponent extends Container {
+	constructor() {
+		super();
+		this.addChild(new Text(
+			`${theme.fg("accent", "↻")} ${theme.fg("muted", "Continuing authorized task")} ${theme.fg("dim", "· internal runtime")}`,
+			1,
+			0,
+		));
+	}
+}
