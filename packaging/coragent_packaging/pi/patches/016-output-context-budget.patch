+/** Input budget before the SDK shrinks the requested output to fit the context. */
+export function contextInputBudget(contextWindow: number, policy: Pick<CompactionPolicy, "reserveTokens" | "maxInputTokens">, maxTokens = 0): number {
+	const reserve = Math.max(policy.reserveTokens, maxTokens > 0 ? maxTokens + 4096 : 0);
+	return Math.max(0, Math.min(contextWindow - reserve, policy.maxInputTokens ?? Number.POSITIVE_INFINITY));
+}
