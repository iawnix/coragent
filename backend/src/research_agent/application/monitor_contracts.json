{
  "binding": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://coragent.iawnix.xyz/contracts/monitor/jobs/binding.schema.json",
    "title": "CoRAgent Job Monitor Binding",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "monitor_id",
      "workspace_id",
      "job_id",
      "job_digest",
      "session_id",
      "wake_policy",
      "notify_policy",
      "created_at",
      "sequence",
      "last_state",
      "node_id",
      "node_revision",
      "user_task_id"
    ],
    "properties": {
      "schema_version": {
        "const": "coragent-job-monitor/2"
      },
      "monitor_id": {
        "type": "string",
        "pattern": "^monitor_[1-9][0-9]*$"
      },
      "workspace_id": {
        "type": "string",
        "minLength": 1
      },
      "job_id": {
        "type": "string",
        "pattern": "^job_[1-9][0-9]*$"
      },
      "job_digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "wake_policy": {
        "enum": [
          "none",
          "next_run"
        ]
      },
      "notify_policy": {
        "const": "none"
      },
      "created_at": {
        "type": "string",
        "minLength": 1
      },
      "sequence": {
        "type": "integer",
        "minimum": 0
      },
      "last_state": {
        "type": [
          "string",
          "null"
        ]
      },
      "queue_wait_reported": {
        "type": "boolean"
      },
      "node_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^node_[1-9][0-9]*$"
      },
      "node_revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "user_task_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^task_[1-9][0-9]*$"
      }
    },
    "oneOf": [
      {
        "properties": {
          "node_id": {
            "type": "null"
          },
          "node_revision": {
            "type": "null"
          }
        }
      },
      {
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^node_[1-9][0-9]*$"
          },
          "node_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    ]
  },
  "event": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://coragent.iawnix.xyz/contracts/monitor/jobs/event.schema.json",
    "title": "CoRAgent Job Monitor Event",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "monitor_id",
      "workspace_id",
      "job_id",
      "job_digest",
      "session_id",
      "wake_policy",
      "notify_policy",
      "created_at",
      "sequence",
      "last_state",
      "event_id",
      "state",
      "previous_state",
      "status_digest",
      "program_status",
      "exit_status",
      "error_class",
      "error",
      "observed_at",
      "status",
      "node_id",
      "node_revision",
      "user_task_id"
    ],
    "properties": {
      "schema_version": {
        "const": "coragent-job-monitor-event/2"
      },
      "monitor_id": {
        "type": "string",
        "pattern": "^monitor_[1-9][0-9]*$"
      },
      "workspace_id": {
        "type": "string",
        "minLength": 1
      },
      "job_id": {
        "type": "string",
        "pattern": "^job_[1-9][0-9]*$"
      },
      "job_digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "wake_policy": {
        "enum": [
          "none",
          "next_run"
        ]
      },
      "notify_policy": {
        "const": "none"
      },
      "created_at": {
        "type": "string",
        "minLength": 1
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "last_state": {
        "type": [
          "string",
          "null"
        ]
      },
      "queue_wait_reported": {
        "type": "boolean"
      },
      "event_id": {
        "type": "string",
        "pattern": "^event_[1-9][0-9]*$"
      },
      "state": {
        "enum": [
          "queued",
          "held",
          "running",
          "succeeded",
          "failed",
          "timed_out",
          "cancelled",
          "unknown"
        ]
      },
      "previous_state": {
        "type": [
          "string",
          "null"
        ]
      },
      "status_digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "program_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "exit_status": {
        "type": [
          "integer",
          "null"
        ]
      },
      "error_class": {
        "type": [
          "string",
          "null"
        ]
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "observed_at": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "object"
      },
      "node_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^node_[1-9][0-9]*$"
      },
      "node_revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "user_task_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^task_[1-9][0-9]*$"
      }
    },
    "oneOf": [
      {
        "properties": {
          "node_id": {
            "type": "null"
          },
          "node_revision": {
            "type": "null"
          }
        }
      },
      {
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^node_[1-9][0-9]*$"
          },
          "node_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    ]
  },
  "delivery": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://coragent.iawnix.xyz/contracts/monitor/jobs/delivery.schema.json",
    "title": "CoRAgent Job Monitor Delivery",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "event_id",
      "session_id",
      "request_id",
      "delivered"
    ],
    "properties": {
      "schema_version": {
        "const": "coragent-job-monitor-delivery/2"
      },
      "event_id": {
        "type": "string",
        "pattern": "^event_[1-9][0-9]*$"
      },
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1
      },
      "delivered": {
        "type": "boolean"
      },
      "batch_event_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^event_[1-9][0-9]*$"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "claim_token": {
        "type": "string",
        "minLength": 1
      },
      "lease_until": {
        "type": "number",
        "minimum": 0
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
