    {
      "id": "research_update",
      "domain": "research",
      "effect": "write",
      "schema": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "shared.json#/tools/research_update/properties/node_id"
          },
          "note": {
            "$ref": "shared.json#/tools/research_update/properties/note"
