{
  "schema_version": "coragent-command-source/1",
  "commands": [
    {
      "id": "research.read",
      "domain": "research",
      "effect": "read",
      "schema": {
        "type": "object",
        "properties": {
          "ref": {
            "anyOf": [
              {
                "$ref": "shared.json#/tools/state/properties/ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "offset": {
            "$ref": "shared.json#/tools/state/properties/offset"
          },
          "limit": {
            "$ref": "shared.json#/tools/state/properties/limit"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focus_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field": {
            "anyOf": [
              {
                "$ref": "shared.json#/tools/state/properties/field"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Internal task navigation roots. Does not authorize or schedule research work."
          },
          "view": {
            "const": "decision",
            "description": "Internal request-only orientation. Omit for full snapshots and explicit reads; not a model parameter."
          },
          "waited_job_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Internal task waits to retain even outside research focus."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {}
      ],
      "result": {
        "$ref": "results.json#/commands/research.read"
      }
    },
