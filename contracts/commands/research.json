          "remove_relations": {
            "$ref": "shared.json#/tools/research_update/properties/remove_relations"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": "string"
          },
          "read_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "subjects": {
            "$ref": "shared.json#/tools/research_update/properties/subjects"
          },
          "references": {
            "$ref": "shared.json#/tools/research_update/properties/references"
          },
          "as_assessment": {
            "$ref": "shared.json#/tools/research_update/properties/as_assessment"
          }
        },
        "required": [
          "node_id",
          "note"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "as_assessment": {
                  "const": true
                }
              },
              "required": [
                "as_assessment"
              ]
            },
            "then": {
              "properties": {
                "assessment_ref": false
              }
            }
          }
        ]
      },
      "examples": [
        {
          "node_id": "node_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "note": "A new observation"
        }
      ],
      "result": {
        "$ref": "results.json#/commands/research_update"
      }
    },
