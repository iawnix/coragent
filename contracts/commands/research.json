{
  "schema_version": "coragent-command-source/1",
  "commands": [
    {
      "id": "research_read",
      "domain": "research",
      "effect": "read",
      "schema": {
        "type": "object",
        "properties": {
          "ref": {
            "anyOf": [
              {
                "$ref": "shared.json#/tools/research_read/properties/ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "offset": {
            "$ref": "shared.json#/tools/research_read/properties/offset"
          },
          "limit": {
            "$ref": "shared.json#/tools/research_read/properties/limit"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focus_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field": {
            "anyOf": [
              {
                "$ref": "shared.json#/tools/research_read/properties/field"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Internal task navigation roots. Does not authorize or schedule research work."
          },
          "source_submission_ids": {
            "$ref": "shared.json#/tools/research_create/properties/source_submission_ids",
            "description": "Current task submission IDs used only to expose their exact Research Memory user_* bindings in the research brief."
          },
          "view": {
            "const": "brief",
            "description": "Internal bounded research-state brief; it does not authorize writes or schedule work."
          },
          "waited_job_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Internal task waits to retain even outside research focus."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {}
      ],
      "result": {
        "$ref": "results.json#/commands/research_read"
      }
    },
