    {
      "id": "job_start",
      "domain": "runtime",
      "schema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Direct submission only: executable and arguments as an argv array, not a shell command string. Declare staged inputs and outputs. Omit with request_file or prepared_ref; submit their pinned command unchanged. Direct commands do not select a scientific Python/backend automatically. For a scientific Python script, prepare with executors --script <file.py> --backend <binding> and submit the returned request file/digest."
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Direct submission only: files/directories the command will produce, relative to Job cwd. job_collect registers available declared outputs with producer provenance. Prepared requests already contain this field. Declarations do not create files or redirect stdout. print() goes to logs/stdout.log; write a result file explicitly before declaring it."
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ]
          },
          "workspace_id": {
            "type": "string"
          },
          "work_id": {
            "type": "string"
          },
          "execution_target": {
            "$ref": "shared.json#/definitions/execution_target"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "validator_id": {
            "type": "string"
          },
          "input_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeat": {
            "$ref": "shared.json#/tools/job_start/properties/repeat"
          },
          "prepared_ref": {
            "type": "string"
          },
          "validator_version": {
            "type": "string"
          },
          "request_file": {
            "type": "string"
          },
          "request_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "user_task_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^task_[1-9][0-9]*$"
          },
          "submission": {
            "$ref": "shared.json#/tools/job_start/properties/submission"
          },
          "execution_context": {
            "$ref": "shared.json#/definitions/execution_context"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {}
      ],
      "result": {
        "$ref": "results.json#/commands/job_start"
      }
    },
